#!/bin/bash

usage() {
    echo "Usage: intlimiter --down|--up --mbit|--mbyte <number> [--interface <iface>]"
    echo "       intlimiter --clear [--interface <iface>]"
    echo ""
    echo "Options:"
    echo "  --down       Limit download speed"
    echo "  --up         Limit upload speed"
    echo "  --mbit       Speed in megabits per second"
    echo "  --mbyte      Speed in megabytes per second"
    echo "  --interface  Network interface (default: auto-detect)"
    echo "  --clear      Remove speed limits"
    exit 1
}

get_interface() {
    ip route | grep default | awk '{print $5}' | head -1
}

clear_limits() {
    local iface=$1
    echo "Clearing speed limits on $iface..."
    sudo tc qdisc del dev "$iface" ingress 2>/dev/null
    sudo tc qdisc del dev "$iface" root 2>/dev/null
    sudo tc qdisc del dev ifb0 root 2>/dev/null
    sudo ip link set ifb0 down 2>/dev/null
    sudo ip link del ifb0 type ifb 2>/dev/null
    echo "Limits cleared."
}

set_download_limit() {
    local iface=$1
    local speed=$2
    local unit=$3

    echo "Setting download limit on $iface to $speed $unit..."

    # Convert to mbit if needed
    local rate_mbit=$speed
    if [ "$unit" = "mbyte" ]; then
        rate_mbit=$(echo "$speed * 8" | bc)
    fi

    # Setup IFB for ingress shaping
    sudo modprobe ifb 2>/dev/null
    sudo ip link add ifb0 type ifb 2>/dev/null || true
    sudo ip link set ifb0 up

    # Redirect ingress to ifb0
    sudo tc qdisc add dev "$iface" handle ffff: ingress 2>/dev/null
    sudo tc filter add dev "$iface" parent ffff: protocol ip u32 match u32 0 0 action mirred egress redirect dev ifb0 2>/dev/null

    # Apply rate limit on ifb0
    sudo tc qdisc add dev ifb0 root handle 1: htb 2>/dev/null || sudo tc qdisc replace dev ifb0 root handle 1: htb
    sudo tc class add dev ifb0 parent 1: classid 1:1 htb rate ${rate_mbit}mbit ceil ${rate_mbit}mbit 2>/dev/null || \
        sudo tc class replace dev ifb0 parent 1: classid 1:1 htb rate ${rate_mbit}mbit ceil ${rate_mbit}mbit
    sudo tc filter add dev ifb0 parent 1: protocol ip u32 match u32 0 0 flowid 1:1 2>/dev/null

    echo "Download limit set to $speed $unit ($rate_mbit mbit)"
}

set_upload_limit() {
    local iface=$1
    local speed=$2
    local unit=$3

    echo "Setting upload limit on $iface to $speed $unit..."

    # Convert to mbit if needed
    local rate_mbit=$speed
    if [ "$unit" = "mbyte" ]; then
        rate_mbit=$(echo "$speed * 8" | bc)
    fi

    # Apply rate limit on egress
    sudo tc qdisc add dev "$iface" root handle 1: htb 2>/dev/null || sudo tc qdisc replace dev "$iface" root handle 1: htb
    sudo tc class add dev "$iface" parent 1: classid 1:1 htb rate ${rate_mbit}mbit ceil ${rate_mbit}mbit 2>/dev/null || \
        sudo tc class replace dev "$iface" parent 1: classid 1:1 htb rate ${rate_mbit}mbit ceil ${rate_mbit}mbit
    sudo tc filter add dev "$iface" parent 1: protocol ip u32 match u32 0 0 flowid 1:1 2>/dev/null

    echo "Upload limit set to $speed $unit ($rate_mbit mbit)"
}

# Parse arguments
DIRECTION=""
UNIT=""
SPEED=""
INTERFACE=""
CLEAR=0

while [[ $# -gt 0 ]]; do
    case $1 in
        --down)
            DIRECTION="down"
            shift
            ;;
        --up)
            DIRECTION="up"
            shift
            ;;
        --mbit)
            UNIT="mbit"
            shift
            ;;
        --mbyte)
            UNIT="mbyte"
            shift
            ;;
        --interface)
            INTERFACE="$2"
            shift 2
            ;;
        --clear)
            CLEAR=1
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            if [ -z "$SPEED" ]; then
                SPEED="$1"
            fi
            shift
            ;;
    esac
done

# Auto-detect interface if not specified
if [ -z "$INTERFACE" ]; then
    INTERFACE=$(get_interface)
fi

if [ $CLEAR -eq 1 ]; then
    clear_limits "$INTERFACE"
    exit 0
fi

# Validate arguments
if [ -z "$DIRECTION" ] || [ -z "$UNIT" ] || [ -z "$SPEED" ]; then
    usage
fi

# Apply limit
if [ "$DIRECTION" = "down" ]; then
    set_download_limit "$INTERFACE" "$SPEED" "$UNIT"
elif [ "$DIRECTION" = "up" ]; then
    set_upload_limit "$INTERFACE" "$SPEED" "$UNIT"
fi
