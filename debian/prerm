#!/bin/sh
set -e

case "$1" in
    remove|purge)
        STATE_FILE="/var/run/intlimiter.state"
        if [ -f "$STATE_FILE" ]; then
            . "$STATE_FILE"
            if [ -n "$INTERFACE" ]; then
                ip link show "$INTERFACE" &>/dev/null && {
                    tc qdisc del dev "$INTERFACE" root 2>/dev/null || true
                    tc qdisc del dev "$INTERFACE" ingress 2>/dev/null || true
                }
            fi
            if [ "$DIRECTION" = "down" ] && [ -n "$IFB_DEV" ]; then
                ip link show "$IFB_DEV" &>/dev/null && {
                    ip link set "$IFB_DEV" down 2>/dev/null || true
                    ip link del "$IFB_DEV" type ifb 2>/dev/null || true
                }
            fi
            rm -f "$STATE_FILE"
        fi
        rm -f /var/run/intlimiter.lock
        ;;

    upgrade|failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0