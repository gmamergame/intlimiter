#!/bin/bash

set -euo pipefail

IFB_DEV="ifb$$"
STATE_FILE="/var/run/intlimiter.state"
DEBUG=0

debug() {
    [[ "$DEBUG" -eq 1 ]] && echo "[DEBUG] $*" >&2
}

log_error() {
    echo "Error: $*" >&2
}

run() {
    local cmd="$*"
    debug "Executing: $cmd"
    if [[ "$DEBUG" -eq 1 ]]; then
        eval "$cmd"
    else
        eval "$cmd" 2>&1 || {
            local exit_code=$?
            log_error "Command failed: $cmd"
            return $exit_code
        }
    fi
}

run_quiet() {
    local cmd="$*"
    debug "Executing: $cmd"
    eval "$cmd" 2>&1 || {
        local exit_code=$?
        debug "Command failed (exit $exit_code): $cmd"
        return $exit_code
    }
}

usage() {
    echo "Usage: intlimiter --down|--up --mbit|--mbyte <number> [--interface <iface>]"
    echo "       intlimiter --clear [--interface <iface>]"
    echo "       intlimiter --status"
    echo "       intlimiter --debug --down --mbit 50"
    echo ""
    echo "Options:"
    echo "  --down       Limit download speed"
    echo "  --up         Limit upload speed"
    echo "  --mbit       Speed in megabits per second"
    echo "  --mbyte      Speed in megabytes per second"
    echo "  --interface  Network interface (default: auto-detect)"
    echo "  --clear      Remove speed limits"
    echo "  --status     Show current limits and qdiscs"
    echo "  --debug      Enable debug output"
    exit 0
}

die() {
    echo "Error: $*" >&2
    exit 1
}

validate_speed() {
    local speed=$1
    if ! [[ "$speed" =~ ^[0-9]+(\.[0-9]+)?$ ]] || (( $(echo "$speed <= 0" | bc -l) )); then
        die "Speed must be a positive number"
    fi
}

validate_interface() {
    local iface=$1
    if ! ip link show "$iface" &>/dev/null; then
        die "Interface '$iface' does not exist"
    fi
}

get_interface() {
    ip route | grep default | awk '{print $5}' | head -1
}

convert_to_mbit() {
    local speed=$1
    local unit=$2

    if [ "$unit" = "mbyte" ]; then
        echo "$speed * 8" | bc | awk '{printf "%.0f", $1}'
    else
        echo "$speed"
    fi
}

save_state() {
    local iface=$1
    local direction=$2
    local speed=$3
    local unit=$4
    local rate_mbit=$5

    cat > "$STATE_FILE" <<EOF
INTERFACE=$iface
DIRECTION=$direction
SPEED=$speed
UNIT=$unit
RATE_MBIT=$rate_mbit
IFB_DEV=$IFB_DEV
EOF
}

load_state() {
    if [[ ! -f "$STATE_FILE" ]]; then
        return 1
    fi
    source "$STATE_FILE"
}

clear_state() {
    rm -f "$STATE_FILE" 2>/dev/null || true
}

teardown_ifb() {
    local ifb_dev=$1
    debug "Tearing down IFB: $ifb_dev"
    if [[ -n "$ifb_dev" ]] && ip link show "$ifb_dev" &>/dev/null; then
        run_quiet sudo ip link set "$ifb_dev" down
        run_quiet sudo ip link del "$ifb_dev" type ifb
    fi
}

teardown_interface() {
    local iface=$1
    debug "Tearing down interface qdiscs: $iface"
    run_quiet sudo tc qdisc del dev "$iface" ingress
    run_quiet sudo tc qdisc del dev "$iface" root
}

show_status() {
    echo "=== intlimiter status ==="

    if ! load_state; then
        echo "No active limits found."
        echo ""
        echo "=== Applied qdiscs ==="
        echo "(none)"
        return
    fi

    echo "Interface: ${INTERFACE:-unknown}"
    echo "Direction: ${DIRECTION:-unknown}"
    echo "Speed: ${SPEED:-unknown} ${UNIT:-unknown}"
    echo "Rate (mbit): ${RATE_MBIT:-unknown}"
    echo "IFB device: ${IFB_DEV:-none}"
    echo ""

    echo "=== Applied qdiscs ==="
    if [[ -n "$INTERFACE" ]]; then
        echo "Interface: $INTERFACE"
        sudo tc qdisc show dev "$INTERFACE" 2>&1 | head -5 || echo "  (none)"
    fi

    if [[ "$DIRECTION" == "down" ]] && [[ -n "$IFB_DEV" ]]; then
        echo ""
        echo "IFB device: $IFB_DEV"
        sudo tc qdisc show dev "$IFB_DEV" 2>&1 | head -5 || echo "  (none)"
    fi
}

clear_limits() {
    local iface=$1
    echo "Clearing speed limits on $iface..."

    if load_state; then
        if [[ "$DIRECTION" == "down" ]]; then
            teardown_ifb "$IFB_DEV"
        fi
        teardown_interface "$iface"
    fi

    clear_state
    echo "Limits cleared."
}

setup_ifb() {
    local ifb_dev=$1

    run sudo modprobe ifb || die "Failed to load ifb module"

    if ! ip link show "$ifb_dev" &>/dev/null; then
        run sudo ip link add "$ifb_dev" type ifb || die "Failed to create $ifb_dev"
    fi
    run sudo ip link set "$ifb_dev" up || die "Failed to bring up $ifb_dev"
}

setup_interface() {
    local iface=$1
    local direction=$2

    run_quiet sudo tc qdisc del dev "$iface" root 2>/dev/null || true
    run sudo tc qdisc add dev "$iface" root handle 1: htb || die "Failed to add qdisc on $iface"

    if [[ "$direction" == "up" ]]; then
        return 0
    fi

    run_quiet sudo tc qdisc add dev "$iface" handle ffff: ingress 2>/dev/null || true
    run sudo tc filter add dev "$iface" parent ffff: protocol ip u32 \
        match u32 0 0 action mirred egress redirect dev "$IFB_DEV" || \
        die "Failed to redirect ingress traffic to IFB"
}

set_download_limit() {
    local iface=$1
    local speed=$2
    local unit=$3

    echo "Setting download limit on $iface to $speed $unit..."

    local rate_mbit
    rate_mbit=$(convert_to_mbit "$speed" "$unit")

    if load_state && [[ "$DIRECTION" == "down" ]]; then
        teardown_ifb "$IFB_DEV"
    fi

    setup_ifb "$IFB_DEV"
    setup_interface "$iface" "down"

    run_quiet sudo tc qdisc del dev "$IFB_DEV" root
    run sudo tc qdisc add dev "$IFB_DEV" root handle 1: htb || die "Failed to add qdisc on $IFB_DEV"
    run sudo tc class add dev "$IFB_DEV" parent 1: classid 1:1 htb rate "${rate_mbit}mbit" ceil "${rate_mbit}mbit" || \
        run sudo tc class replace dev "$IFB_DEV" parent 1: classid 1:1 htb rate "${rate_mbit}mbit" ceil "${rate_mbit}mbit" || \
        die "Failed to set rate limit on IFB"
    run_quiet sudo tc filter add dev "$IFB_DEV" parent 1: protocol ip u32 match u32 0 0 flowid 1:1

    save_state "$iface" "down" "$speed" "$unit" "$rate_mbit"
    echo "Download limit set to $speed $unit ($rate_mbit mbit)"
}

set_upload_limit() {
    local iface=$1
    local speed=$2
    local unit=$3

    echo "Setting upload limit on $iface to $speed $unit..."

    local rate_mbit
    rate_mbit=$(convert_to_mbit "$speed" "$unit")

    setup_interface "$iface" "up"

    run sudo tc class add dev "$iface" parent 1: classid 1:1 htb rate "${rate_mbit}mbit" ceil "${rate_mbit}mbit" || \
        run sudo tc class replace dev "$iface" parent 1: classid 1:1 htb rate "${rate_mbit}mbit" ceil "${rate_mbit}mbit" || \
        die "Failed to set rate limit on $iface"
    run_quiet sudo tc filter add dev "$iface" parent 1: protocol ip u32 match u32 0 0 flowid 1:1

    save_state "$iface" "up" "$speed" "$unit" "$rate_mbit"
    echo "Upload limit set to $speed $unit ($rate_mbit mbit)"
}

DIRECTION=""
UNIT=""
SPEED=""
INTERFACE=""
CLEAR=0
STATUS=0
DEBUG=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --down)
            [[ -n "$DIRECTION" ]] && die "Direction already specified (--down or --up)"
            [[ -n "$SPEED" ]] && die "Speed must come after --mbit or --mbyte"
            [[ -n "$UNIT" ]] && die "Unit already specified (--mbit or --mbyte)"
            DIRECTION="down"
            ;;
        --up)
            [[ -n "$DIRECTION" ]] && die "Direction already specified (--down or --up)"
            [[ -n "$SPEED" ]] && die "Speed must come after --mbit or --mbyte"
            [[ -n "$UNIT" ]] && die "Unit already specified (--mbit or --mbyte)"
            DIRECTION="up"
            ;;
        --mbit)
            [[ -n "$UNIT" ]] && die "Unit already specified (--mbit or --mbyte)"
            [[ -z "$DIRECTION" ]] && die "Direction (--down or --up) must come before --mbit"
            UNIT="mbit"
            ;;
        --mbyte)
            [[ -n "$UNIT" ]] && die "Unit already specified (--mbit or --mbyte)"
            [[ -z "$DIRECTION" ]] && die "Direction (--down or --up) must come before --mbyte"
            UNIT="mbyte"
            ;;
        --interface)
            [[ -z "${2:-}" ]] && die "Option --interface requires a value"
            [[ "$2" == -* ]] && die "Option --interface requires a value"
            INTERFACE="$2"
            shift
            ;;
        --clear)
            [[ -n "$DIRECTION" ]] && die "Cannot use --clear with --down or --up"
            [[ -n "$UNIT" ]] && die "Cannot use --clear with --mbit or --mbyte"
            [[ -n "$SPEED" ]] && die "Cannot use --clear with a speed value"
            [[ "$STATUS" -eq 1 ]] && die "Cannot use --clear with --status"
            CLEAR=1
            ;;
        --status)
            [[ "$CLEAR" -eq 1 ]] && die "Cannot use --status with --clear"
            [[ -n "$DIRECTION" ]] && die "Cannot use --status with --down or --up"
            [[ -n "$UNIT" ]] && die "Cannot use --status with --mbit or --mbyte"
            [[ -n "$SPEED" ]] && die "Cannot use --status with a speed value"
            STATUS=1
            ;;
        --help|-h)
            usage
            ;;
        --debug)
            DEBUG=1
            ;;
        -*)
            die "Unknown option: $1"
            ;;
        *)
            [[ -n "$SPEED" ]] && die "Multiple speed values provided"
            [[ -z "$UNIT" ]] && die "Speed must come after --mbit or --mbyte"
            SPEED="$1"
            ;;
    esac
    shift
done

if [[ "$STATUS" -eq 1 ]]; then
    show_status
    exit 0
fi

if [[ -z "$INTERFACE" ]]; then
    INTERFACE=$(get_interface) || die "Failed to detect network interface"
fi

[[ -n "$INTERFACE" ]] || die "No network interface found"
validate_interface "$INTERFACE"

if [[ "$CLEAR" -eq 1 ]]; then
    clear_limits "$INTERFACE"
    exit 0
fi

if [[ -z "$DIRECTION" ]] || [[ -z "$UNIT" ]] || [[ -z "$SPEED" ]]; then
    usage
fi

validate_speed "$SPEED"

if [[ "$DIRECTION" == "down" ]]; then
    set_download_limit "$INTERFACE" "$SPEED" "$UNIT"
else
    set_upload_limit "$INTERFACE" "$SPEED" "$UNIT"
fi