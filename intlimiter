#!/bin/bash

set -euo pipefail

IFB_DEV="ifb$$"

usage() {
    echo "Usage: intlimiter --down|--up --mbit|--mbyte <number> [--interface <iface>]"
    echo "       intlimiter --clear [--interface <iface>]"
    echo ""
    echo "Options:"
    echo "  --down       Limit download speed"
    echo "  --up         Limit upload speed"
    echo "  --mbit       Speed in megabits per second"
    echo "  --mbyte      Speed in megabytes per second"
    echo "  --interface  Network interface (default: auto-detect)"
    echo "  --clear      Remove speed limits"
    exit 0
}

die() {
    echo "Error: $*" >&2
    exit 1
}

validate_speed() {
    local speed=$1
    if ! [[ "$speed" =~ ^[0-9]+(\.[0-9]+)?$ ]] || (( $(echo "$speed <= 0" | bc -l) )); then
        die "Speed must be a positive number"
    fi
}

validate_interface() {
    local iface=$1
    if ! ip link show "$iface" &>/dev/null; then
        die "Interface '$iface' does not exist"
    fi
}

get_interface() {
    ip route | grep default | awk '{print $5}' | head -1
}

convert_to_mbit() {
    local speed=$1
    local unit=$2

    if [ "$unit" = "mbyte" ]; then
        echo "$speed * 8" | bc | awk '{printf "%.0f", $1}'
    else
        echo "$speed"
    fi
}

clear_limits() {
    local iface=$1
    echo "Clearing speed limits on $iface..."

    if ip link show "$IFB_DEV" &>/dev/null; then
        sudo ip link set "$IFB_DEV" down 2>/dev/null || true
        sudo ip link del "$IFB_DEV" type ifb 2>/dev/null || true
    fi

    sudo tc qdisc del dev "$iface" ingress 2>/dev/null || true
    sudo tc qdisc del dev "$iface" root 2>/dev/null || true

    echo "Limits cleared."
}

set_download_limit() {
    local iface=$1
    local speed=$2
    local unit=$3

    echo "Setting download limit on $iface to $speed $unit..."

    local rate_mbit
    rate_mbit=$(convert_to_mbit "$speed" "$unit")

    cleanup() {
        sudo ip link set "$IFB_DEV" down 2>/dev/null || true
        sudo ip link del "$IFB_DEV" type ifb 2>/dev/null || true
    }
    trap cleanup EXIT

    sudo modprobe ifb 2>/dev/null || die "Failed to load ifb module"

    if ! ip link show "$IFB_DEV" &>/dev/null; then
        sudo ip link add "$IFB_DEV" type ifb || die "Failed to create $IFB_DEV"
    fi
    sudo ip link set "$IFB_DEV" up || die "Failed to bring up $IFB_DEV"

    sudo tc qdisc add dev "$iface" handle ffff: ingress 2>/dev/null || true
    sudo tc filter add dev "$iface" parent ffff: protocol ip u32 \
        match u32 0 0 action mirred egress redirect dev "$IFB_DEV" 2>/dev/null || \
        die "Failed to redirect ingress traffic"

    sudo tc qdisc del dev "$IFB_DEV" root 2>/dev/null || true
    sudo tc qdisc add dev "$IFB_DEV" root handle 1: htb || die "Failed to add qdisc on $IFB_DEV"
    sudo tc class add dev "$IFB_DEV" parent 1: classid 1:1 htb rate "${rate_mbit}mbit" ceil "${rate_mbit}mbit" 2>/dev/null || \
        sudo tc class replace dev "$IFB_DEV" parent 1: classid 1:1 htb rate "${rate_mbit}mbit" ceil "${rate_mbit}mbit" || \
        die "Failed to set rate limit"
    sudo tc filter add dev "$IFB_DEV" parent 1: protocol ip u32 match u32 0 0 flowid 1:1 2>/dev/null || true

    echo "Download limit set to $speed $unit ($rate_mbit mbit)"
}

set_upload_limit() {
    local iface=$1
    local speed=$2
    local unit=$3

    echo "Setting upload limit on $iface to $speed $unit..."

    local rate_mbit
    rate_mbit=$(convert_to_mbit "$speed" "$unit")

    sudo tc qdisc del dev "$iface" root 2>/dev/null || true
    sudo tc qdisc add dev "$iface" root handle 1: htb || die "Failed to add qdisc"
    sudo tc class add dev "$iface" parent 1: classid 1:1 htb rate "${rate_mbit}mbit" ceil "${rate_mbit}mbit" 2>/dev/null || \
        sudo tc class replace dev "$iface" parent 1: classid 1:1 htb rate "${rate_mbit}mbit" ceil "${rate_mbit}mbit" || \
        die "Failed to set rate limit"
    sudo tc filter add dev "$iface" parent 1: protocol ip u32 match u32 0 0 flowid 1:1 2>/dev/null || true

    echo "Upload limit set to $speed $unit ($rate_mbit mbit)"
}

DIRECTION=""
UNIT=""
SPEED=""
INTERFACE=""
CLEAR=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --down)
            [[ -n "$DIRECTION" ]] && die "Direction already specified (--down or --up)"
            [[ -n "$SPEED" ]] && die "Speed must come after --mbit or --mbyte"
            [[ -n "$UNIT" ]] && die "Unit already specified (--mbit or --mbyte)"
            DIRECTION="down"
            ;;
        --up)
            [[ -n "$DIRECTION" ]] && die "Direction already specified (--down or --up)"
            [[ -n "$SPEED" ]] && die "Speed must come after --mbit or --mbyte"
            [[ -n "$UNIT" ]] && die "Unit already specified (--mbit or --mbyte)"
            DIRECTION="up"
            ;;
        --mbit)
            [[ -n "$UNIT" ]] && die "Unit already specified (--mbit or --mbyte)"
            [[ -z "$DIRECTION" ]] && die "Direction (--down or --up) must come before --mbit"
            UNIT="mbit"
            ;;
        --mbyte)
            [[ -n "$UNIT" ]] && die "Unit already specified (--mbit or --mbyte)"
            [[ -z "$DIRECTION" ]] && die "Direction (--down or --up) must come before --mbyte"
            UNIT="mbyte"
            ;;
        --interface)
            [[ -z "${2:-}" ]] && die "Option --interface requires a value"
            [[ "$2" == -* ]] && die "Option --interface requires a value"
            INTERFACE="$2"
            shift
            ;;
        --clear)
            [[ -n "$DIRECTION" ]] && die "Cannot use --clear with --down or --up"
            [[ -n "$UNIT" ]] && die "Cannot use --clear with --mbit or --mbyte"
            [[ -n "$SPEED" ]] && die "Cannot use --clear with a speed value"
            CLEAR=1
            ;;
        --help|-h)
            usage
            ;;
        -*)
            die "Unknown option: $1"
            ;;
        *)
            [[ -n "$SPEED" ]] && die "Multiple speed values provided"
            [[ -z "$UNIT" ]] && die "Speed must come after --mbit or --mbyte"
            SPEED="$1"
            ;;
    esac
    shift
done

if [[ -z "$INTERFACE" ]]; then
    INTERFACE=$(get_interface) || die "Failed to detect network interface"
fi

[[ -n "$INTERFACE" ]] || die "No network interface found"
validate_interface "$INTERFACE"

if [[ "$CLEAR" -eq 1 ]]; then
    clear_limits "$INTERFACE"
    exit 0
fi

if [[ -z "$DIRECTION" ]] || [[ -z "$UNIT" ]] || [[ -z "$SPEED" ]]; then
    usage
fi

validate_speed "$SPEED"

if [[ "$DIRECTION" == "down" ]]; then
    set_download_limit "$INTERFACE" "$SPEED" "$UNIT"
else
    set_upload_limit "$INTERFACE" "$SPEED" "$UNIT"
fi